{# Production serves the apex host; every PR preview gets its own subdomain, or Caddy would
   reject two site blocks claiming the same name. Preview hostnames need a wildcard
   *.money.yarden-zamir.com DNS record pointing at the VPS. #}
{% if environment == "prod" -%}
money.yarden-zamir.com
{%- else -%}
pr.{{ environment.removeprefix("pr-") }}.money.yarden-zamir.com
{%- endif %} {
    reverse_proxy unix//{{ paths.default_socket }}
}
